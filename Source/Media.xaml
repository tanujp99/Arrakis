    <BitmapImage x:Key="AgeMarkEsrbRp" UriSource="{ThemeFile 'Images/AgeRatings/esrb_rp.png'}" RenderOptions.BitmapScalingMode="Fant" popt:Freeze="True"/>

    <BitmapImage x:Key="TrayIcon" UriSource="{ThemeFile 'Images/applogo.ico'}" RenderOptions.BitmapScalingMode="Fant" popt:Freeze="True"/>
