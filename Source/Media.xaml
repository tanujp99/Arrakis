<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:popt="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <!--
        The completion badge resources lived here. Nothing references them now
        that the hero badge is gone, and a frozen BitmapImage decodes at load
        whether or not anything draws it, so keeping them would be a startup
        cost for art on screen nowhere.

        The PNGs stay under Images/Badges and tools/make_badges.py still
        regenerates them from source, so re-declaring these is a paste job
        when the better version arrives.
    -->

    <!--
        Official age rating marks, from Wikimedia Commons. Fant rather than
        NearestNeighbor: these are smooth vector renders, the opposite of the
        pixel-art badges above. Opt-in through the theme settings; the drawn
        marks stay the default so the package does not ship trademarked art
        unless it is asked for.
    -->
    <BitmapImage x:Key="AgeMarkPegi3" UriSource="{ThemeFile 'Images/AgeRatings/pegi_3.png'}" RenderOptions.BitmapScalingMode="Fant" popt:Freeze="True"/>
    <BitmapImage x:Key="AgeMarkPegi7" UriSource="{ThemeFile 'Images/AgeRatings/pegi_7.png'}" RenderOptions.BitmapScalingMode="Fant" popt:Freeze="True"/>
    <BitmapImage x:Key="AgeMarkPegi12" UriSource="{ThemeFile 'Images/AgeRatings/pegi_12.png'}" RenderOptions.BitmapScalingMode="Fant" popt:Freeze="True"/>
    <BitmapImage x:Key="AgeMarkPegi16" UriSource="{ThemeFile 'Images/AgeRatings/pegi_16.png'}" RenderOptions.BitmapScalingMode="Fant" popt:Freeze="True"/>
    <BitmapImage x:Key="AgeMarkPegi18" UriSource="{ThemeFile 'Images/AgeRatings/pegi_18.png'}" RenderOptions.BitmapScalingMode="Fant" popt:Freeze="True"/>
    <BitmapImage x:Key="AgeMarkEsrbEc" UriSource="{ThemeFile 'Images/AgeRatings/esrb_ec.png'}" RenderOptions.BitmapScalingMode="Fant" popt:Freeze="True"/>
    <BitmapImage x:Key="AgeMarkEsrbE" UriSource="{ThemeFile 'Images/AgeRatings/esrb_e.png'}" RenderOptions.BitmapScalingMode="Fant" popt:Freeze="True"/>
    <BitmapImage x:Key="AgeMarkEsrbE10" UriSource="{ThemeFile 'Images/AgeRatings/esrb_e10.png'}" RenderOptions.BitmapScalingMode="Fant" popt:Freeze="True"/>
    <BitmapImage x:Key="AgeMarkEsrbT" UriSource="{ThemeFile 'Images/AgeRatings/esrb_t.png'}" RenderOptions.BitmapScalingMode="Fant" popt:Freeze="True"/>
    <BitmapImage x:Key="AgeMarkEsrbM" UriSource="{ThemeFile 'Images/AgeRatings/esrb_m.png'}" RenderOptions.BitmapScalingMode="Fant" popt:Freeze="True"/>
