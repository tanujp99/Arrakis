                                                                                        <Setter TargetName="Fallback" Property="Visibility" Value="Collapsed" />
                                                                                        <Setter TargetName="Pegi" Property="Visibility" Value="Visible" />
                                                                                        <Setter TargetName="Pegi" Property="Background" Value="#F5A623" />
                                                                                        <Setter TargetName="PegiVal" Property="Text" Value="16" />
                                                                                        <Setter TargetName="PegiTag" Property="Foreground" Value="#F5A623" />
                                                                                    </DataTrigger>
