                                                        <!--Details Panel Ends-->

                                                    </StackPanel>
                                                    <!--Details Panel (stacked) Ends-->

                                                    <!--Play Stats Card (stacked)-->
                                                    <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2" Margin="0">

                                                        <StackPanel Margin="0,0,0,32">
                                                            <StackPanel.Resources>
                                                                <Style TargetType="ItemsControl">
                                                                    <Setter Property="VerticalAlignment" Value="Top" />
                                                                    <Setter Property="Margin" Value="0,8,0,0" />
                                                                </Style>
                                                                <Style TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
                                                                    <Setter Property="Margin" Value="0,12,12,0" />
                                                                    <Setter Property="VerticalAlignment" Value="Top" />
                                                                    <Setter Property="HorizontalAlignment" Value="Left" />
                                                                    <Setter Property="Opacity" Value="0.6" />
                                                                    <Setter Property="MaxWidth" Value="140" />
                                                                    <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
                                                                </Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource PropertyItemButton}">
                                                                    <Setter Property="VerticalAlignment" Value="Top" />
                                                                    <Setter Property="Margin" Value="0,4,0,0" />
                                                                </Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                                                                    <Setter Property="Margin" Value="0,0,0,0" />
                                                                </Style>
                                                            </StackPanel.Resources>

                                                            <Grid>
                                                                <Border CornerRadius="{DynamicResource ControlCornerRadiusLarge}" Style="{DynamicResource DetailViewCardBorder}" />
                                                                <StackPanel Margin="20,16,20,16">
                                                                    <!--
                                                                        Literal, not a {DynamicResource LOC...}. Keys added to the
                                                                        theme's LocSource.xaml do not resolve at runtime: Playnite
                                                                        owns the LOC namespace and its own dictionary wins. A missing
                                                                        key renders blank rather than failing, so the header simply
                                                                        vanished.
                                                                    -->
                                                                    <TextBlock Text="Play Stats" FontWeight="Bold" />
                                                                    <GridEx x:Name="PlayStatsGrid" ColumnCount="2" StarColumns="1" RowCount="25" AutoLayoutColumns="2">

                                                                        <!--
                                                                            The player's own score leads this card: it is the most
                                                                            personal datum here, and the one field on the panel that
                                                                            is theirs rather than the game's.
                                                                        -->
                                                                        <Label Name="PART_ElemUserScore" Content="{DynamicResource LOCUserScore}" />
                                                                        <!--
                                                                            Shown on the 0 to 6 scale it was actually entered on, not the
                                                                            0 to 100 field it is stored in. StarRatings divides 100 by 6
                                                                            with integer arithmetic, so a star is worth exactly 16 and
                                                                            the raw number tops out at 96. Reading 96 as a near miss when
                                                                            it means six of six is the whole problem, and adding 4 to
                                                                            close that gap would fix only the top: it would leave 0
                                                                            reading as 4.

                                                                            Dividing by 16 is exact for every value the plugin writes,
                                                                            half stars included, so nothing needs rounding. Multiply by
                                                                            0.0625 rather than DivideConverter, since this is the same
                                                                            converter the hearts already rely on.

                                                                            PART_TextUserScore stays wired and invisible: Playnite fills
                                                                            its Tag with the ScoreRating that colours the badge, and its
                                                                            Visibility already hides the row for unscored games. Only
                                                                            the digits are ours.
                                                                        -->
                                                                        <Border Style="{DynamicResource ScoreBadgeBorder}"
                                                                                Tag="{Binding ElementName=PART_TextUserScore, Path=Tag}"
                                                                                Visibility="{Binding ElementName=PART_TextUserScore, Path=Visibility}">
                                                                            <Grid>
                                                                                <TextBlock Name="PART_TextUserScore" Opacity="0" />
                                                                                <TextBlock Style="{DynamicResource ScoreBadgeText}"
                                                                                        Text="{Binding Game.UserScore, Converter={PluginConverter Plugin=ThemeExtras, Converter=MultiplyConverter}, ConverterParameter=0.0625, FallbackValue=''}" />
                                                                            </Grid>
                                                                        </Border>

                                                                        <Label Content="{DynamicResource LOCPlatformTitle}" />
                                                                        <ItemsControl ItemsSource="{Binding Game.Platforms}" Margin="0,8,0,0" />

                                                                        <Label Name="PART_ElemLibrary" Content="{DynamicResource LOCGameProviderTitle}" />
                                                                        <Button Name="PART_ButtonLibrary" Margin="0,12,0,0" />

                                                                        <Label Name="PART_ElemPlayTime" Content="{DynamicResource LOCTimePlayed}" />
                                                                        <TextBlock Name="PART_TextPlayTime" Margin="0,12,0,0" />

                                                                        <Label Name="PART_ElemLastPlayed" Content="{DynamicResource LOCLastPlayed}" />
                                                                        <TextBlock Name="PART_TextLastActivity" Margin="0,12,0,0" />

                                                                        <Label Name="PART_ElemRecentActivity" Content="{DynamicResource LOCRecentActivityLabel}" />
                                                                        <TextBlock Name="PART_TextRecentActivity" Margin="0,12,0,0" />

                                                                        <Label Name="PART_ElemAdded" Content="{DynamicResource LOCDateAddedLabel}" />
                                                                        <TextBlock Name="PART_TextAdded" Margin="0,12,0,0" />

                                                                        <!-- Plain text: the wired button now lives in the hero as the trophy. -->
                                                                        <Label Name="PART_ElemCompletionStatus" Content="{DynamicResource LOCCompletionStatus}" />
                                                                        <TextBlock Text="{Binding Game.CompletionStatus.Name}" Margin="0,12,0,0" />

                                                                        <Label Content="{DynamicResource LOCSuccessStoryAchievements}" />
                                                                        <StackPanel Name="PART_SuccessStory" Orientation="Horizontal" Margin="0,12,0,0">
                                                                            <TextBlock Text="{PluginSettings Plugin=SuccessStory, Path=Unlocked, FallbackValue='-'}" />
                                                                            <TextBlock Text="/" />
                                                                            <TextBlock Text="{PluginSettings Plugin=SuccessStory, Path=Total, FallbackValue='-'}" />
                                                                        </StackPanel>

                                                                    </GridEx>
                                                                </StackPanel>
                                                            </Grid>
                                                        </StackPanel>

                                                    </StackPanel>
                                                    <!--Play Stats Card (stacked) Ends-->

                                                    <!--Overview Tabs (stacked)-->
                                                    <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="5" Margin="0">

                                                        <!--Tab Table-->
                                                        <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Stretch">

                                                            <TabControl Margin="0,0,0,16" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                                                                    Style="{StaticResource DetailViewTabControl}">
                                                                <!--Tab Overview-->
                                                                <TabItem Header="{DynamicResource LOCOverviewLabel}" x:Name="DescriptionTab" FontSize="16">

                                                                    <StackPanel Margin="0,24,0,0">

                                                                        <StackPanel x:Name="DescriptionContent" Margin="0,0,0,0" Tag="{DynamicResource ThemeDarkStyle}">
                                                                            <StackPanel Name="PART_ElemDescription">
                                                                                <HtmlTextView Name="PART_HtmlDescription" Margin="0,0,0,0" HorizontalAlignment="Stretch"
                                                                                        HtmlFontSize="{DynamicResource FontSize}" HtmlFontFamily="{DynamicResource FontFamily}"
                                                                                        LinkForeground="{DynamicResource AccentSelectedColor}"
                                                                                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                                                        ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                                                                    <HtmlTextView.Style>
                                                                                        <Style TargetType="HtmlTextView">
                                                                                            <Setter Property="HtmlForeground" Value="{DynamicResource TextColor}" />
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding Tag, ElementName=DescriptionContent}" Value="True">
                                                                                                    <Setter Property="HtmlForeground" Value="{DynamicResource TextColorDark}" />
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </HtmlTextView.Style>
                                                                                </HtmlTextView>
                                                                            </StackPanel>
