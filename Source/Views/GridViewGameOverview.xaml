                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </ItemsControl.Style>
                                                                        <ItemsControl.ItemsPanel>
                                                                            <!--
                                            Vertical, so a second rating stacks below the first
                                            rather than crowding the header. Playnite normally
                                            stores only one, chosen by AgeRatingOrgPriority in its
                                            config, so this usually renders a single mark.
                                        -->
                                        <ItemsPanelTemplate><StackPanel Orientation="Vertical" /></ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Grid Margin="0,0,0,4">
                                                                            <!--
                                                                                Official artwork, opt-in. Sits beside the drawn marks rather than
                                                                                replacing them: the toggle hides one set and shows the other, so a
                                                                                package that never turns it on ships no trademarked art.
                                                                            -->
                                                                            <Image x:Name="OfficialMark" Visibility="Collapsed" Height="66" Stretch="Uniform"
                                                                                   HorizontalAlignment="Right" VerticalAlignment="Top" />
                                                                            <!--
                                                                                The drawn mark is scaled by a Viewbox rather than by editing the
                                                                                six nested sizes it is built from, so its proportions stay put.
                                                                                Explicit Height with Stretch=Uniform: a Viewbox left to itself
                                                                                fills whatever cell it lands in and ignores its child's size.
                                                                            -->
                                                                            <Viewbox Height="66" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                                            <Grid x:Name="DrawnMark" Tag="{DynamicResource AgeRatingOfficialArt}">
                                                                                <Grid.Style>
                                                                                    <Style TargetType="Grid">
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="Visible">
                                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Grid.Style>
                                                                                    <!--
                                                                                        Thickness is pre-divided by the Viewbox scale (66/49), so
                                                                                        1.25 here lands at roughly 1.7 on screen. The stroke gets
                                                                                        scaled like everything else, which is what made a value
                                                                                        that was fine at 49px read as heavy at 66.
                                                                                    -->
                                                                                    <Border x:Name="Pegi" Visibility="Collapsed" Width="38" Height="49" CornerRadius="5" Background="#4C9C2E"
                                        BorderBrush="#141414" BorderThickness="1.25">
                                                                                        <Grid>
                                                                                            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="11" /></Grid.RowDefinitions>
                                                                                            <TextBlock x:Name="PegiVal" Foreground="White" FontWeight="Bold" FontSize="28" Margin="0,-2,0,0"
                                                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                                            <Border Grid.Row="1" Background="White" CornerRadius="0,0,3,3">
                                                                                                <TextBlock x:Name="PegiTag" Text="www.pegi.info" FontSize="5" FontWeight="Bold" Foreground="#141414"
                                                                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                                            </Border>
                                                                                        </Grid>
                                                                                    </Border>
                                                                                    <Border x:Name="Esrb" Visibility="Collapsed" Width="38" Height="49" CornerRadius="3"
                                                                                            Background="White" BorderBrush="#111111" BorderThickness="1.25">
                                                                                        <Grid>
                                                                                            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="14" /></Grid.RowDefinitions>
                                                                                            <TextBlock x:Name="EsrbVal" Foreground="#111111" FontWeight="Bold" FontSize="24" Margin="0,-1,0,0"
                                                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                                            <Border Grid.Row="1" Background="#111111">
                                                                                                <TextBlock Text="ESRB" FontSize="8" FontWeight="Bold" Foreground="White"
                                                                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                                            </Border>
                                                                                        </Grid>
                                                                                    </Border>
                                                                                    <Border x:Name="Fallback" Height="20" CornerRadius="3" Background="#6B7280" Padding="6,0,6,0">
                                                                                        <TextBlock Text="{Binding Name}" Foreground="White" FontSize="10" VerticalAlignment="Center" />
                                                                                    </Border>
                                                                                                                                                            </Grid>
                                                                            </Viewbox>
                                                                        </Grid>
                                                                                <DataTemplate.Triggers>
                                                                                    <DataTrigger Binding="{Binding Name}" Value="PEGI 3">
                                                                                    <Setter TargetName="OfficialMark" Property="Source" Value="{DynamicResource AgeMarkPegi3}" />
                                                                                    <Setter TargetName="OfficialMark" Property="Visibility" Value="{DynamicResource AgeRatingOfficialArt}" />
                                                                                        <Setter TargetName="Fallback" Property="Visibility" Value="Collapsed" />
                                                                                        <Setter TargetName="Pegi" Property="Visibility" Value="Visible" />
                                                                                        <Setter TargetName="Pegi" Property="Background" Value="#4C9C2E" />
                                                                                        <Setter TargetName="PegiVal" Property="Text" Value="3" />
                                                                                        <Setter TargetName="PegiTag" Property="Foreground" Value="#4C9C2E" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Name}" Value="PEGI 7">
                                                                                    <Setter TargetName="OfficialMark" Property="Source" Value="{DynamicResource AgeMarkPegi7}" />
                                                                                    <Setter TargetName="OfficialMark" Property="Visibility" Value="{DynamicResource AgeRatingOfficialArt}" />
                                                                                        <Setter TargetName="Fallback" Property="Visibility" Value="Collapsed" />
                                                                                        <Setter TargetName="Pegi" Property="Visibility" Value="Visible" />
                                                                                        <Setter TargetName="Pegi" Property="Background" Value="#4C9C2E" />
                                                                                        <Setter TargetName="PegiVal" Property="Text" Value="7" />
                                                                                        <Setter TargetName="PegiTag" Property="Foreground" Value="#4C9C2E" />
                                                                                    </DataTrigger>
