<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                    mc:Ignorable="d">

    <Style TargetType="{x:Type GridViewGameOverview}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GridViewGameOverview}">
                    <Border Padding="0" BorderBrush="{DynamicResource PanelSeparatorBrush}"
                            d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameDetailsIntance}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderThickness" Value="1,0,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Settings GridViewDetailsPosition}" Value="Left">
                                        <Setter Property="BorderThickness" Value="0,0,1,0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Settings ShowPanelSeparators}" Value="False">
                                        <Setter Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <DockPanel MinWidth="300">

                            <Grid DockPanel.Dock="Top">

                                <DockPanel>
                                    <DockPanel.Style>
                                        <Style TargetType="DockPanel">
                                            <Style.Triggers>
                                                <Trigger Property="DataContext" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DockPanel.Style>

                                    <Grid Margin="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.RowSpan="2">
                                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Grid.Row="0"
                                                    Style="{DynamicResource DetailsScrollViewer}" d:DesignWidth="1280" d:DesignHeight="1280"
                                                    d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameDetailsIntance}" x:Name="PART_ScrollViewHost">

                                                <Grid MaxWidth="{DynamicResource GameOverviewWidth}" MinWidth="300" Margin="24,0,24,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="{Settings CalculatedGameDetailsIndentation}" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>

                                                    <Grid Margin="0,0,0,40" Grid.ColumnSpan="2" Grid.Row="0">
                                                        <Grid.Resources>
                                                            <VisualBrush x:Key="ClonedVisualBrush" Visual="{Binding ElementName=PART_ImageBackground}" />
                                                        </Grid.Resources>

                                                        <Grid x:Name="HeroBanner">
                                                            <Grid.OpacityMask>
                                                                <VisualBrush>
                                                                    <VisualBrush.Visual>
                                                                        <Border Background="Black" CornerRadius="{DynamicResource ControlCornerRadiusLargeX}"
                                                                                Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
                                                                                Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}}" />
                                                                    </VisualBrush.Visual>
                                                                </VisualBrush>
                                                            </Grid.OpacityMask>

                                                            <!--Game background image-->
                                                            <Grid ClipToBounds="True">
                                                                <!--Blurred Layer-->
                                                                <Rectangle Fill="{DynamicResource ClonedVisualBrush}">
                                                                    <Rectangle.Effect>
                                                                        <BlurEffect Radius="120" />
                                                                    </Rectangle.Effect>
                                                                </Rectangle>

                                                                <!--Gradient Layer-->
                                                                <Grid>
                                                                    <Grid.OpacityMask>
                                                                        <RadialGradientBrush GradientOrigin="0.5,1" Center="0.5,1" RadiusX="1.2" RadiusY="0.6">
                                                                            <RadialGradientBrush.GradientStops>
                                                                                <GradientStop Color="#00FFFFFF" Offset="0.4" />
                                                                                <GradientStop Color="White" Offset="0.6" />
                                                                            </RadialGradientBrush.GradientStops>
                                                                        </RadialGradientBrush>
                                                                    </Grid.OpacityMask>
                                                                    <FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill" HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                                            FlowDirection="LeftToRight" />
                                                                </Grid>
                                                            </Grid>
                                                            <!--Game background image Ends-->

                                                            <!--Game video-->
                                                            <Grid x:Name="GameVideo">
                                                                <Grid.Style>
                                                                    <Style TargetType="Grid">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding ElementName=VideoThumbnail, Path=IsChecked}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding ElementName=ImageThumbnail, Path=IsChecked}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Grid.Style>
                                                                <Rectangle>
                                                                    <Rectangle.Fill>
                                                                        <VisualBrush Visual="{Binding ElementName=ExtraMetadataLoader_VideoLoaderControl}" Stretch="UniformToFill" />
                                                                    </Rectangle.Fill>
                                                                </Rectangle>
                                                            </Grid>
                                                            <!--Game video Ends-->

                                                            <!--Daken Layer-->
                                                            <Border Background="#99000000">
                                                                <Border.OpacityMask>
                                                                    <LinearGradientBrush StartPoint="0.5,1" EndPoint="0.5,0">
                                                                        <GradientStop Color="White" Offset="0" />
                                                                        <GradientStop Color="Transparent" Offset="0.5" />
                                                                    </LinearGradientBrush>
                                                                </Border.OpacityMask>
                                                            </Border>

                                                        </Grid>

                                                        <!--Extra Logo-->
                                                        <Grid Margin="40,40,0,40" HorizontalAlignment="Left" VerticalAlignment="Top">
                                                            <Border x:Name="GameIcon" CornerRadius="{StaticResource ControlCornerRadius}">
                                                                <Image Name="PART_ImageIcon" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                        RenderOptions.BitmapScalingMode="Fant" MaxHeight="120" MaxWidth="120" />
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger
                                                                                    Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=EnableLogos, FallbackValue=False}"
                                                                                    Value="False">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                            <DataTrigger
                                                                                    Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=IsLogoAvailable, FallbackValue=False}"
                                                                                    Value="False">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}, FallbackValue=False}"
                                                                                    Value="false">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                            </Border>
                                                        </Grid>

                                                        <!--
                                                            The logo needs its own container. It used to share the icon's Grid
                                                            above, which is Left/Top aligned and sizes to its own content, so
                                                            centring the logo inside it centred it within a box that hugged the
                                                            logo, which does nothing. Every logo was pinned top-left; the ones that read
                                                            as centred were simply wide enough to reach the middle, which is why
                                                            narrow logos looked wrong and wide ones looked fine.

                                                            This Grid stretches instead, so Center means the hero's centre. The
                                                            right margin matches the left (the old one was 0, which let wide
                                                            logos run under the settings button).

                                                            Bottom aligned rather than centred, because the hero darkens toward
                                                            the bottom and vertical centre is the brightest, busiest part of the
                                                            artwork. Sitting the logo in the gradient buys legibility on every
                                                            game at once, which per-game positioning could only do one game at a
                                                            time. Anchoring to the bottom edge also keeps the offset stable as
                                                            the hero grows and shrinks with the panel; a top margin would not.
                                                        -->
                                                        <Grid Margin="40,44,40,76">
                                                            <Border x:Name="ExtraMetadataLoader_LogoLoaderControlGrid" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                                                    Tag="{DynamicResource DetailsViewAllowUseOfLogos}">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger
                                                                                    Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=EnableLogos, FallbackValue=False}"
                                                                                    Value="False">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                            <DataTrigger
                                                                                    Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=IsLogoAvailable, FallbackValue=False}"
                                                                                    Value="False">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}, FallbackValue=False}"
                                                                                    Value="false">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <ContentControl x:Name="ExtraMetadataLoader_LogoLoaderControl" />
                                                            </Border>
                                                        </Grid>
                                                        <!--Extra Logo Ends-->

                                                        <Grid VerticalAlignment="Bottom" Margin="40">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <!--
                                                                Image/video switcher, off. A local Visibility outranks every
                                                                trigger in the style below, so the markup stays intact and
                                                                turning it back on is a one-word change. It cost roughly half
                                                                the panel width and pushed the genres off the edge; the logo
                                                                is the part of ExtraMetadataLoader worth the space here.
                                                            -->
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom"
                                                                    Visibility="Collapsed">
                                                                <StackPanel.Style>
                                                                    <Style TargetType="StackPanel">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger
                                                                                    Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=EnableVideoPlayer, FallbackValue=False}"
                                                                                    Value="False">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                            <DataTrigger
                                                                                    Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=IsAnyVideoAvailable, FallbackValue=False}"
                                                                                    Value="True">
                                                                                <Setter Property="Control.Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                            <DataTrigger
                                                                                    Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=EnableAlternativeDetailsVideoPlayer, FallbackValue=False}"
                                                                                    Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </StackPanel.Style>
                                                                <!--Image Thumbnail-->
                                                                <Grid Width="88" Height="50">
                                                                    <Grid Margin="4">
                                                                        <Grid.OpacityMask>
                                                                            <VisualBrush>
                                                                                <VisualBrush.Visual>
                                                                                    <Border Background="Black" CornerRadius="{DynamicResource ControlCornerRadius}"
                                                                                            Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
                                                                                            Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}}" />
                                                                                </VisualBrush.Visual>
                                                                            </VisualBrush>
                                                                        </Grid.OpacityMask>
                                                                        <Rectangle>
                                                                            <Rectangle.Fill>
                                                                                <VisualBrush Visual="{Binding ElementName=PART_ImageBackground}" Stretch="UniformToFill" />
                                                                            </Rectangle.Fill>
                                                                        </Rectangle>
                                                                    </Grid>
                                                                    <Border Background="Transparent" BorderBrush="White" BorderThickness="2"
                                                                            CornerRadius="{DynamicResource ControlCornerRadius}"
                                                                            Visibility="{Binding ElementName=ImageThumbnail, Path=IsChecked, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                    <RadioButton Name="ImageThumbnail" GroupName="ThumbnailControl"
                                                                            Command="{Binding ElementName=ExtraMetadataLoader_VideoLoaderControl, Path=Content.VideoPauseCommand}"
                                                                            Style="{DynamicResource TransparentRadioButton}" />
                                                                </Grid>
                                                                <!--Video Thumbnail-->
                                                                <Grid Margin="10,0,0,0" Width="88" Height="50">
                                                                    <Grid Margin="4">
                                                                        <Grid.OpacityMask>
                                                                            <VisualBrush>
                                                                                <VisualBrush.Visual>
                                                                                    <Border Background="Black" CornerRadius="{DynamicResource ControlCornerRadius}"
                                                                                            Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
                                                                                            Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}}" />
                                                                                </VisualBrush.Visual>
                                                                            </VisualBrush>
                                                                        </Grid.OpacityMask>
                                                                        <ContentControl x:Name="ExtraMetadataLoader_VideoLoaderControl">
                                                                            <ContentControl.Template>
                                                                                <ControlTemplate TargetType="ContentControl">
                                                                                    <Viewbox Stretch="UniformToFill" VerticalAlignment="Top">
                                                                                        <Grid>
                                                                                            <ContentPresenter />
                                                                                            <Border Background="Transparent" />
                                                                                        </Grid>
                                                                                    </Viewbox>
                                                                                </ControlTemplate>
                                                                            </ContentControl.Template>
                                                                        </ContentControl>
                                                                    </Grid>

                                                                    <Border Background="#99000000" BorderBrush="#33FFFFFF" BorderThickness="1" Width="44" Height="44"
                                                                            CornerRadius="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                        <Viewbox Name="ThumbnailPlay" Margin="13,12,11,12">
                                                                            <TextBlock Text="&#xf5b0;" Foreground="White" Style="{StaticResource IconFontStyle}" />
                                                                        </Viewbox>
                                                                    </Border>
                                                                    <Border Background="Transparent" BorderBrush="White" BorderThickness="2"
                                                                            CornerRadius="{DynamicResource ControlCornerRadius}"
                                                                            Visibility="{Binding ElementName=VideoThumbnail, Path=IsChecked, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                    <RadioButton Name="VideoThumbnail" GroupName="ThumbnailControl"
                                                                            IsChecked="{PluginSettings Plugin=ExtraMetadataLoader, Path=IsVideoPlaying}"
                                                                            Command="{Binding ElementName=ExtraMetadataLoader_VideoLoaderControl, Path=Content.VideoPlayCommand}"
                                                                            Style="{DynamicResource TransparentRadioButton}" />
                                                                </Grid>

                                                            </StackPanel>

                                                            <!--GameInfo-->
                                                            <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Bottom"
                                                                    HorizontalAlignment="Stretch" Margin="0,0,16,0">
                                                                <DockPanel LastChildFill="True">
                                                                    <!--
                                                                        The logo already says the name, usually better than text can.
                                                                        Rather than re-derive when a logo exists, the title watches the
                                                                        logo border's own visibility, so the two cannot disagree.
                                                                    -->
                                                                    <TextBlock Text="{Binding Game.Name}" FontSize="{DynamicResource FontSizeLarge24}"
                                                                            FontWeight="Bold" Foreground="White" TextWrapping="Wrap"
                                                                            HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,8">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding ElementName=ExtraMetadataLoader_LogoLoaderControlGrid, Path=Visibility}"
                                                                                            Value="Visible">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </DockPanel>
                                                                <StackPanel Orientation="Horizontal">


                                                                <Button Name="PART_ButtonSource" Margin="4,2,4,0" Padding="0" Style="{DynamicResource PropertyItemOutlinedButton}" />
                                                                <StackPanel Name="PART_ElemGenres" Orientation="Horizontal">
                                                                    <StackPanel.Style>
                                                                        <Style TargetType="StackPanel">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Settings DetailsVisibility.Genres}" Value="False">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Game.Genres}" Value="{x:Null}">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </StackPanel.Style>
                                                                    <ItemsControl ItemsSource="{Binding Game.Genres}" Margin="0,2,0,0">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <WrapPanel Orientation="Horizontal" />
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Button Content="{Binding Name}" Margin="4,0,4,0" Padding="0,0,0,0"
                                                                                        Style="{DynamicResource PropertyItemOutlinedButton}"
                                                                                        Command="{Binding RelativeSource={RelativeSource AncestorType=Grid}, Path=DataContext.SetPlatformFilterCommand}"
                                                                                        CommandParameter="{Binding}" />
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </StackPanel>

                                                            </StackPanel>
                                                            </StackPanel>

                                                        </Grid>


                                                        <StackPanel Name="VideoControlButton" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                                Margin="0,0,40,120">
                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition
                                                                                        Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=IsAnyVideoAvailable, FallbackValue=False}"
                                                                                        Value="True" />
                                                                                <Condition Binding="{Binding ElementName=VideoThumbnail, Path=IsChecked}" Value="True" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>
                                                            <ToggleButton HorizontalAlignment="Left" x:Name="TrailerPauseButton" Tag="&#xe103;"
                                                                    Command="{Binding ElementName=ExtraMetadataLoader_VideoLoaderControl, Path=Content.VideoPauseCommand, FallbackValue={x:Null}}"
                                                                    Visibility="{Binding ElementName=TrailerPlayButton, Path=IsEnabled, Converter={StaticResource InvertedBooleanToVisibilityConverter}}"
                                                                    Style="{DynamicResource IconRoundedToggleButton}">

                                                            </ToggleButton>
                                                            <ToggleButton HorizontalAlignment="Left" x:Name="TrailerPlayButton" Tag="&#xe102;"
                                                                    Command="{Binding ElementName=ExtraMetadataLoader_VideoLoaderControl, Path=Content.VideoPlayCommand, FallbackValue={x:Null}}"
                                                                    Visibility="{Binding RelativeSource={RelativeSource Mode=Self}, Path=IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                    Style="{DynamicResource IconRoundedToggleButton}">

                                                            </ToggleButton>

                                                            <CheckBox Margin="8,0,0,0"
                                                                    IsChecked="{Binding ElementName=ExtraMetadataLoader_VideoLoaderControl, Path=Content.IsPlayerMuted, Mode=TwoWay, FallbackValue={StaticResource True}}">
                                                                <CheckBox.Template>
                                                                    <ControlTemplate TargetType="CheckBox">
                                                                        <Border Name="Border" BorderThickness="1" BorderBrush="#33FFFFFF" Background="#33000000" Width="36"
                                                                                Height="36" CornerRadius="18">
                                                                            <TextBlock x:Name="NotMuted" Text="&#xe198;" Style="{StaticResource IconFontStyle}" Margin="8"
                                                                                    Foreground="White" />
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsChecked" Value="True">
                                                                                <Setter Property="Text" TargetName="NotMuted" Value="&#xe994;" />
                                                                            </Trigger>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter Property="Background" Value="#66000000" TargetName="Border" />
                                                                                <Setter Property="BorderBrush" Value="#66FFFFFF" TargetName="Border" />
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </CheckBox.Template>
                                                            </CheckBox>
                                                        </StackPanel>
                                                    </Grid>

                                                    <Grid Grid.ColumnSpan="2" Grid.Row="4" Name="PART_ElemLinks" Margin="0,0,0,40">
                                                        <Border CornerRadius="{DynamicResource ControlCornerRadiusLarge}" Style="{DynamicResource DetailViewCardBorder}"
                                                                Margin="0,0,0,0" />
                                                        <ItemsControl ItemsSource="{Binding Game.Links}" Margin="16,16,16,8"
                                                                Visibility="{Binding ElementName=PART_ElemLinks, Path=Visibility}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel Orientation="Horizontal" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate DataType="{x:Type Link}">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <Button Content="{Binding Name}" Style="{StaticResource PropertyItemLinkButton}" ToolTip="{Binding Url}"
                                                                                Command="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=DataContext.OpenLinkCommand}"
                                                                                CommandParameter="{Binding}" />
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                    </Grid>

                                                    <!--Details Panel (stacked)-->
                                                    <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="3" Margin="0">

                                                        <!--Details Panel-->
                                                        <StackPanel Margin="0,0,0,32">
                                                            <StackPanel.Resources>
                                                                <Style TargetType="ItemsControl">
                                                                    <Setter Property="VerticalAlignment" Value="Top" />
                                                                    <Setter Property="Margin" Value="0,8,0,0" />
                                                                </Style>
                                                                <Style TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
                                                                    <Setter Property="Margin" Value="0,12,12,0" />
                                                                    <Setter Property="VerticalAlignment" Value="Top" />
                                                                    <Setter Property="HorizontalAlignment" Value="Left" />
                                                                    <Setter Property="Opacity" Value="0.6" />
                                                                    <Setter Property="MaxWidth" Value="140" />
                                                                    <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
                                                                </Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource PropertyItemButton}">
                                                                    <Setter Property="VerticalAlignment" Value="Top" />
                                                                    <Setter Property="Margin" Value="0,4,0,0" />
                                                                </Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                                                                    <Setter Property="Margin" Value="0,0,0,0" />
                                                                </Style>
                                                            </StackPanel.Resources>

                                                            <Grid>
                                                                <Border CornerRadius="{DynamicResource ControlCornerRadiusLarge}" Style="{DynamicResource DetailViewCardBorder}" />
                                                                <StackPanel Margin="20,16,20,16">
                                                                    <StackPanel>
                                                                        <TextBlock Text="{DynamicResource LOCGameDetails}" FontWeight="Bold" />
                                                                        <GridEx x:Name="GDGrid" ColumnCount="2" StarColumns="1" RowCount="25" AutoLayoutColumns="2">

                                                                            <!--
                                                                                The hero hides the title whenever a logo is present, so the
                                                                                name has to live somewhere that always shows it. Plain
                                                                                TextBlock rather than a PART_: the name is never absent,
                                                                                so there is no row to collapse.
                                                                            -->
                                                                            <Label Content="{DynamicResource LOCNameLabel}" />
                                                                            <TextBlock Text="{Binding Game.Name}" TextWrapping="Wrap"
                                                                                    VerticalAlignment="Center" Margin="0,12,0,0" />

                                                                            <Label Name="PART_ElemDevelopers" Content="{DynamicResource LOCDeveloperLabel}" />
                                                                            <ItemsControl Name="PART_ItemsDevelopers" />

                                                                            <Label Name="PART_ElemPublishers" Content="{DynamicResource LOCPublisherLabel}" />
                                                                            <ItemsControl Name="PART_ItemsPublishers" />

                                                                            <Label Name="PART_ElemSeries" Content="{DynamicResource LOCSeriesLabel}" />
                                                                            <ItemsControl Name="PART_ItemsSeries" />

                                                                            <Label Content="{DynamicResource LOCGameReleaseDateTitle}" />
                                                                            <Button Name="PART_ButtonReleaseDate" Margin="0,12,0,0" />

                                                                            <!--
                                                                                Age rating is not a row here. It renders as a mark at the
                                                                                bottom of this card, below Tags.
                                                                            -->

                                                                            <Label Name="PART_ElemRegion" Content="{DynamicResource LOCRegionLabel}" />
                                                                            <ItemsControl Name="PART_ItemsRegions" />

                                                                            <!--
                                                                                Critic and community scores are properties of the game, so
                                                                                they live here. The player's own score is "this copy" data
                                                                                and sits in the Play Stats card instead.

                                                                                Tag and Visibility are forwarded from the PART_ TextBlock,
                                                                                which is the only element Playnite wires up: it sets the
                                                                                ScoreRating that picks the colour, and collapses the row
                                                                                when there is no score. Without the Visibility binding an
                                                                                empty badge would be left behind.
                                                                            -->
                                                                            <!--
                                                                                Critic and community share one row, side by side, the way
                                                                                DekuDeals puts them. Both are boxed rather than one boxed
                                                                                and one coloured text: the mixed band is #f5C518, and
                                                                                yellow text is unreadable on the light theme's card. A
                                                                                filled box carries its own contrast in either theme.

                                                                                The label mirrors the row's Visibility rather than
                                                                                carrying a Style of its own, which would shadow the
                                                                                card's implicit Label style and lose the shared margins
                                                                                and opacity.
                                                                            -->
                                                                            <Label Content="Rating"
                                                                                   Visibility="{Binding ElementName=ScoreRow, Path=Visibility}" />
                                                                            <StackPanel x:Name="ScoreRow" Orientation="Horizontal">
                                                                                <StackPanel.Style>
                                                                                    <Style TargetType="StackPanel">
