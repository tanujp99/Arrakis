                                                                                        <Setter TargetName="Fallback" Property="Visibility" Value="Collapsed" />
                                                                                        <Setter TargetName="Pegi" Property="Visibility" Value="Visible" />
                                                                                        <Setter TargetName="Pegi" Property="Background" Value="#D0021B" />
                                                                                        <Setter TargetName="PegiVal" Property="Text" Value="18" />
                                                                                        <Setter TargetName="PegiTag" Property="Foreground" Value="#D0021B" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Name}" Value="ESRB EC">
                                                                                    <Setter TargetName="OfficialMark" Property="Source" Value="{DynamicResource AgeMarkEsrbEc}" />
                                                                                    <Setter TargetName="OfficialMark" Property="Visibility" Value="{DynamicResource AgeRatingOfficialArt}" />
                                                                                        <Setter TargetName="Fallback" Property="Visibility" Value="Collapsed" />
                                                                                        <Setter TargetName="Esrb" Property="Visibility" Value="Visible" />
                                                                                        <Setter TargetName="EsrbVal" Property="Text" Value="EC" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Name}" Value="ESRB E">
                                                                                    <Setter TargetName="OfficialMark" Property="Source" Value="{DynamicResource AgeMarkEsrbE}" />
                                                                                    <Setter TargetName="OfficialMark" Property="Visibility" Value="{DynamicResource AgeRatingOfficialArt}" />
                                                                                        <Setter TargetName="Fallback" Property="Visibility" Value="Collapsed" />
                                                                                        <Setter TargetName="Esrb" Property="Visibility" Value="Visible" />
                                                                                        <Setter TargetName="EsrbVal" Property="Text" Value="E" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Name}" Value="ESRB E10+">
                                                                                    <Setter TargetName="OfficialMark" Property="Source" Value="{DynamicResource AgeMarkEsrbE10}" />
                                                                                    <Setter TargetName="OfficialMark" Property="Visibility" Value="{DynamicResource AgeRatingOfficialArt}" />
                                                                                        <Setter TargetName="Fallback" Property="Visibility" Value="Collapsed" />
                                                                                        <Setter TargetName="Esrb" Property="Visibility" Value="Visible" />
                                                                                        <Setter TargetName="EsrbVal" Property="Text" Value="E10+" />
