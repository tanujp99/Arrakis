<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="GridViewItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <StackPanel Margin="{Settings ItemSpacingMargin}">
                        <Grid x:Name="ItemGrid" Background="{DynamicResource GridItemBackgroundBrush}">

                            <ContentPresenter />
                            <Border x:Name="SelectedGlossHighlightBorder" BorderThickness="3" Margin="-4" Visibility="Collapsed" Style="{DynamicResource GlossHighlightBorder}"
                                    Tag="{DynamicResource GridViewGameCoverUseRoundedCorners}">
                            </Border>
                            <Border x:Name="SelectedBorder" BorderThickness="3" Margin="-4" Visibility="Collapsed" Style="{DynamicResource SelectedCoverBorder}"
                                    Tag="{DynamicResource GridViewGameCoverUseRoundedCorners}" />
                            <TextBlock Name="EnableHighlightBorder" Visibility="Collapsed" Tag="{DynamicResource GridViewGameCoverShowHighlightBorder}" />
                        </Grid>
                        <StackPanel Margin="0,8,0,4">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding ElementName=GameName, Path=Visibility}" Value="Collapsed" />
                                                <Condition Binding="{Binding ElementName=PlayingStatus, Path=Visibility}" Value="Collapsed" />
                                                <Condition Binding="{Binding ElementName=PlayedTime, Path=Visibility}" Value="Collapsed" />
                                                <Condition Binding="{Binding ElementName=UserScorePips, Path=Visibility}" Value="Collapsed" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock x:Name="GameName" Text="{Binding DisplayName}" FontSize="{DynamicResource FontSizeSmall}" Style="{DynamicResource BaseTextBlockStyle}"
                                    TextAlignment="Left" TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom" Width="{Settings GridItemWidth}"
                                    Visibility="{Settings ShowNamesUnderCovers}" Margin="0,0,0,4" />
                            <!--
                                My score, as six pips under the title.

                                Deliberately not bucketed into the seven points.
                                The filled row is a copy of the outline row clipped to a
                                width proportional to the raw 0-100 UserScore, so a
                                fine-tuned 72 renders as 4.3 pips rather than being
                                rounded to 4. Bucketing would need range comparisons,
                                which XAML cannot do without a converter.

                                Bound through Game.UserScore, not UserScore. The tile's
                                DataContext exposes a curated set of its own properties and
                                score is not among them, so the short path bound to nothing,
                                came back null, and matched the x:Null trigger below: the
                                pips collapsed on every game including scored ones.

                                Hearts rather than stars: a row that drains as the score
                                drops reads like a life bar, which is the right metaphor for
                                a game library.

                                The glyph's ink sits low in its em box, so centring the
                                element still left the row reading low against the text
                                beside it; a slightly smaller size and a two pixel lift put
                                it on the same optical line. The cell width is fixed, so
                                changing the size does not disturb the fill maths.

                                The lift belongs on the whole row, not on the glyphs. Applied
                                to the glyphs it moved the filled ones up inside the clipping
                                container that produces the fill, which simply sheared their
                                tops off.

                                Each heart is a fixed 13px cell, so the row is exactly 78px
                                and the fill factor is a known 0.78 per point of score.
                                Setting Width on a single six-glyph TextBlock did not do
                                that: it padded the box without stretching the glyphs, so
                                the glyphs covered less than the clip assumed and a score of
                                68 lit five of six instead of four.
                            -->
                            <!--Time Played-->
                            <DockPanel x:Name="PlayedTime" Width="{Settings GridItemWidth}" Visibility="{DynamicResource GridViewGameCoverShowPlayedTime}" Margin="0,0,0,4">
                                <TextBlock Text="&#xe121;" FontSize="{DynamicResource FontSizeSmall}" TextAlignment="Left" Margin="0,0,0,0"
                                           Style="{StaticResource IconFontStyle}" />
                                <TextBlock Text="{Binding Playtime, Mode=OneWay, Converter={StaticResource PlayTimeToStringConverter}, IsAsync=True}"
                                           FontSize="{DynamicResource FontSizeSmall}" TextAlignment="Left" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="4,0,0,0"
                                        Style="{DynamicResource BaseTextBlockStyle}" />
                            </DockPanel>
                            <!--
                                The stars set their own font and foreground rather than using
                                IconFontStyle. That style picks its Foreground from a Tag
                                compared against the strings "True" and "False" while the
                                resource behind it is a Boolean, the same mismatch that left
                                the selection border invisible, and it overwrites Tag, which
                                this element needs for its own toggle.

                                The row carries its own visibility: collapsing only when both
                                halves are gone. Without that the wrapper stayed put and the
                                two settings appeared to depend on each other.

                                Score and completion status share one line. Stacked, the pair
                                overflowed the space under the cover and the status was clipped
                                away; side by side they fit without adding height to the tile.
                            -->
                            <DockPanel x:Name="ScoreStatusRow" Width="{Settings GridItemWidth}" Margin="0,0,0,4">
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ElementName=UserScorePips, Path=Visibility}" Value="Collapsed" />
                                                    <Condition Binding="{Binding ElementName=PlayingStatus, Path=Visibility}" Value="Collapsed" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>
                            <Grid x:Name="UserScorePips" DockPanel.Dock="Right" Width="78" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,-2,0,0"
                                  Tag="{DynamicResource GridViewGameCoverShowUserScore}">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <!-- Unscored games show nothing rather than an empty row. -->
                                            <DataTrigger Binding="{Binding Game.UserScore}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="Collapsed">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <StackPanel Orientation="Horizontal" Opacity="0.3">
                                    <TextBlock Text="&#xEB51;" Width="13" FontSize="11.5" TextAlignment="Center" VerticalAlignment="Center"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource TextBrush}" />
                                    <TextBlock Text="&#xEB51;" Width="13" FontSize="11.5" TextAlignment="Center" VerticalAlignment="Center"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource TextBrush}" />
                                    <TextBlock Text="&#xEB51;" Width="13" FontSize="11.5" TextAlignment="Center" VerticalAlignment="Center"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource TextBrush}" />
                                    <TextBlock Text="&#xEB51;" Width="13" FontSize="11.5" TextAlignment="Center" VerticalAlignment="Center"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource TextBrush}" />
                                    <TextBlock Text="&#xEB51;" Width="13" FontSize="11.5" TextAlignment="Center" VerticalAlignment="Center"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource TextBrush}" />
                                    <TextBlock Text="&#xEB51;" Width="13" FontSize="11.5" TextAlignment="Center" VerticalAlignment="Center"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource TextBrush}" />
                                </StackPanel>

                                <!--
                                    0.8125 is 78/96, not 78/100. StarRatings works out points per
                                    star with integer division: 100/6 gives 16, not 16.67, so six
                                    stars is 96 and the scale never reaches 100. Scaling against
                                    100 left every rating just short of its heart, which is why
                                    five stars lit four hearts and most of a fifth.

                                    At 78/96 the whole scale lands exactly: 16 fills one heart,
                                    96 fills six, and because the half-star values are multiples
                                    of 8 they land on exact half hearts too.

                                    A stray 100 from before StarRatings overruns to 81px, and the
                                    ClipToBounds above trims it back to a full six.
                                -->
                                <Grid HorizontalAlignment="Left" ClipToBounds="True"
                                      Width="{Binding Game.UserScore, Converter={PluginConverter Plugin=ThemeExtras, Converter=MultiplyConverter}, ConverterParameter=0.8125, FallbackValue=0}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <TextBlock Text="&#xEB52;" Width="13" FontSize="11.5" TextAlignment="Center" VerticalAlignment="Center"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource TextBrush}" />
                                        <TextBlock Text="&#xEB52;" Width="13" FontSize="11.5" TextAlignment="Center" VerticalAlignment="Center"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource TextBrush}" />
                                        <TextBlock Text="&#xEB52;" Width="13" FontSize="11.5" TextAlignment="Center" VerticalAlignment="Center"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource TextBrush}" />
                                        <TextBlock Text="&#xEB52;" Width="13" FontSize="11.5" TextAlignment="Center" VerticalAlignment="Center"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource TextBrush}" />
                                        <TextBlock Text="&#xEB52;" Width="13" FontSize="11.5" TextAlignment="Center" VerticalAlignment="Center"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource TextBrush}" />
                                        <!--
                                            The sixth heart is gold, because six is not simply one
                                            more than five. The working scale runs 1 to 5 and this
                                            slot is the rare one, so it should not look like the
                                            others do. A literal gold rather than the accent brush:
                                            the accent is user-set and could land anywhere, and this
                                            needs to read as special in both themes.

                                            Deeper than the gold first chosen. #E0A400 measured
                                            1.9:1 against the light background, under the 3:1 floor
                                            for a mark that carries meaning, so on the light theme
                                            it was the one heart you could not see. #A87400 is
                                            3.4:1 on light and 4.5:1 on dark: still unmistakably
                                            gold beside the near-black hearts, and legible in both.

                                            It only appears as the fill reaches the last heart, so
                                            5.5 shows half of it, which is the right amount of
                                            almost.
                                        -->
                                        <TextBlock Text="&#xEB52;" Width="13" FontSize="11.5" TextAlignment="Center" VerticalAlignment="Center"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#A87400" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                            <!--Playing Status-->
                            <DockPanel x:Name="PlayingStatus" Tag="{DynamicResource GridViewGameCoverShowCompletionStatus}" Margin="0,0,0,4">
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CompletionStatus.Name, TargetNullValue='', FallbackValue=''}" Value=''>
                                                <Setter Property="Visibility" Value="Hidden" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="Collapsed">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>
                                <!-- Same glyph vocabulary as the hero trophy, so the two read as one thing. -->
                                <TextBlock FontSize="{DynamicResource FontSizeSmall}" TextAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource IconFontStyle}">
                                            <Setter Property="Text" Value="&#xE9F9;" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CompletionStatus.Name}" Value="Not Played">
                                                    <Setter Property="Text" Value="&#xE738;" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CompletionStatus.Name}" Value="Plan to Play">
                                                    <Setter Property="Text" Value="&#xE787;" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CompletionStatus.Name}" Value="Playing">
                                                    <Setter Property="Text" Value="&#xE768;" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CompletionStatus.Name}" Value="On Hold">
                                                    <Setter Property="Text" Value="&#xE769;" />
                                                </DataTrigger>
                                                <!--
                                                    Played, Beaten and Completed are one ladder, so they
                                                    get one shape that fills up: ring, disc, star. The
                                                    label next to the glyph already carries the meaning,
                                                    which frees the glyph to carry the ranking instead.
                                                -->
                                                <DataTrigger Binding="{Binding CompletionStatus.Name}" Value="Played">
                                                    <Setter Property="Text" Value="&#xECCA;" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CompletionStatus.Name}" Value="Beaten">
                                                    <Setter Property="Text" Value="&#xE91F;" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CompletionStatus.Name}" Value="Completed">
                                                    <Setter Property="Text" Value="&#xE735;" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CompletionStatus.Name}" Value="Abandoned">
                                                    <Setter Property="Text" Value="&#xE711;" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock x:Name="CompletionStatusName" Text="{Binding CompletionStatus.Name, Mode=OneWay, IsAsync=True}" TextAlignment="Left"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" 
                                           FontSize="{DynamicResource FontSizeSmall}" VerticalAlignment="Center"
                                           Margin="4,0,0,0" Style="{DynamicResource BaseTextBlockStyle}" />
                            </DockPanel>
                            </DockPanel>
                        </StackPanel>


                    </StackPanel>

                    <ControlTemplate.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding ElementName=EnableHighlightBorder, Path=Tag}" Value="True" />
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsSelected}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" TargetName="SelectedGlossHighlightBorder" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding ElementName=EnableHighlightBorder, Path=Tag}" Value="False" />
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsSelected}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" TargetName="SelectedBorder" />
                        </MultiDataTrigger>
                        <!--<Trigger Property="IsSelected" Value="True">
            <Setter Property="Visibility" Value="Visible" TargetName="SelectedBorder" />
            <Setter Property="Canvas.ZIndex" Value="990" />
        </Trigger>-->
                        <DataTrigger Binding="{Settings ShowGridItemBackground}" Value="False">
                            <Setter Property="Background" Value="Transparent" TargetName="ItemGrid" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlossHighlightBorder" TargetType="Border">
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="BorderBrush">
            <Setter.Value>
                <!--
                    Was a white sweep, which is invisible on the light theme's
                    near-white background. Built from the selection accent so the
                    animated variant reads in both themes, same as the plain ring.
                -->
                <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                    <GradientStop Color="#662F6FED" Offset="0" />
                    <GradientStop Color="#662F6FED" Offset="0" />
                    <GradientStop Color="#FF5B8FF5" Offset="0.2" />
                    <GradientStop Color="#662F6FED" Offset="0.6" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag, Mode=OneWay}" Value="True">
                <Setter Property="CornerRadius" Value="{DynamicResource GridViewSelectionBorderCornerRadius}" />
            </DataTrigger>
            <!--
                Runs only while the border is actually visible, which means only
                on the selected tile.

                This was on RoutedEvent="Loaded". That border exists in every
                tile and is collapsed until selection, but WPF animates collapsed
                elements just the same, so a library of several hundred covers was
                running several hundred infinite storyboards at once. Nothing was
                visible from any of them.
            -->
            <Trigger Property="Visibility" Value="Visible">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="GlossSweep">
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetProperty="BorderBrush.(GradientBrush.GradientStops)[1].(GradientStop.Offset)" From="-1.4" To="1.2" Duration="0:0:3.5">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="BorderBrush.(GradientBrush.GradientStops)[2].(GradientStop.Offset)" From="-1.2" To="1.4" Duration="0:0:3.5">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="GlossSweep" />
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>
    <!--
        The brush is set unconditionally, not chosen by a per-theme trigger.
        The old pair of triggers compared a Tag, typed object, against the
        strings "True" and "False" while the underlying resource is a Boolean,
        so they could not be relied on to fire: matching neither left the
        border with no brush, and matching the dark one painted white on the
        light theme's near-white background. Both look identical from the
        outside, which is no visible selection.
    -->
    <Style x:Key="SelectedCoverBorder" TargetType="Border">
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="BorderBrush" Value="{DynamicResource GridViewSelectionAccentBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag, Mode=OneWay}" Value="True">
                <Setter Property="CornerRadius" Value="{DynamicResource GridViewSelectionBorderCornerRadius}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>