<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="TextBlockGameScore" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">

        <Style.Triggers>
            <Trigger Property="Tag" Value="{x:Static ScoreRating.Positive}">
                <Setter Property="Foreground" Value="{DynamicResource PositiveRatingBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static ScoreRating.Negative}">
                <Setter Property="Foreground" Value="{DynamicResource NegativeRatingBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static ScoreRating.Mixed}">
                <Setter Property="Foreground" Value="{DynamicResource MixedRatingBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        Metacritic-style score badge: a filled square holding the number, rather
        than the coloured text above. Playnite sets Tag on any PART_Text*Score
        element to a ScoreRating, using the same thresholds Metacritic does
        (75 and up positive, 50 to 74 mixed, under 50 negative), so the banding
        is its work, not ours. The Border cannot read that Tag itself, since
        only the named TextBlock is wired up, so callers bind Border.Tag to the
        child's.

        These live here, beside the style they replace, because a new
        dictionary file in DerivedStyles is not picked up.
    -->
    <Style x:Key="ScoreBadgeBorder" TargetType="Border">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="24" />
        <!--
            Top margin is tuned so the number's centre line matches the label's.
            The right margin spaces badges when several sit in a row.
        -->
        <Setter Property="Margin" Value="0,5,8,0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <!-- No score yet: a muted box rather than a misleading colour. -->
        <Setter Property="Background" Value="{DynamicResource TextBrushDarker}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="{x:Static ScoreRating.Positive}">
                <Setter Property="Background" Value="{DynamicResource PositiveRatingBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="{x:Static ScoreRating.Mixed}">
                <Setter Property="Background" Value="{DynamicResource MixedRatingBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="{x:Static ScoreRating.Negative}">
                <Setter Property="Background" Value="{DynamicResource NegativeRatingBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        The number itself. Foreground flips to near-black on the mixed band:
        that brush is #f5C518, and white on yellow is unreadable. Metacritic
        makes the same switch.
    -->
    <Style x:Key="ScoreBadgeText" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="Foreground" Value="White" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="{x:Static ScoreRating.Mixed}">
                <Setter Property="Foreground" Value="#1A1A1A" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
